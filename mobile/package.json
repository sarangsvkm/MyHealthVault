{
  "name": "myhealthvault-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "desktop": "electron electron/main.js",
    "desktop:dev": "set ELECTRON_DEV=1&& electron electron/main.js",
    "desktop:start": "npm run web:export && electron electron/main.js",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "^58.0.17",
    "electron": "^45.2.3",
    "expo": "~54.0.0",
    "expo-dev-client": "~6.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-file-system": "~19.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-notifications": "~0.32.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-task-manager": "~14.0.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.0",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^3.4.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.0"
  }
}
